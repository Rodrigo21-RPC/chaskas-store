{
  "name": "chaskas-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
    "test": "vitest run",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "validate:browser": "node scripts/validate-browser.js",
    "validate:runtime": "node scripts/validate-runtime.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "26.1.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
